{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm --filter @workspace/slips-morocco run build",
  "outputDirectory": "artifacts/slips-morocco/dist/public",
  "rewrites": [
    { "source": "/technology", "destination": "/index.html" },
    { "source": "/industries", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/roadmap", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ]
}
